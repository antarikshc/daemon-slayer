<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.antariksh.daemonslayer</string>
	<key>ProgramArguments</key>
	<array>
		<string>@APP_PATH@/Contents/MacOS/daemonslayer</string>
		<string>--agent</string>
	</array>
	<!-- Launch at login (spec 9.1) -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Relaunch on crash; long-running resident process, not StartInterval (spec 9.1) -->
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- launchd does NOT expand $HOME, so @HOME@ is substituted to a literal path at install time -->
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/daemonslayer.stdio.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/daemonslayer.stdio.log</string>
</dict>
</plist>
